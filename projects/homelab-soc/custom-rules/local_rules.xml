<!--
  Custom Wazuh detection rules for the Home Lab SOC project.

  Drop this into the manager as /var/ossec/etc/rules/local_rules.xml and restart the
  manager service to load it.

  IMPORTANT: field names below (win.eventdata.*) assume Wazuh's default Sysmon decoding.
  Before trusting these, trigger the matching Atomic test once, find the raw alert in
  Discover/Threat Hunting, and confirm the field names match what your Wazuh version
  actually produces — decoder field paths have shifted slightly across Wazuh releases.

  Rule IDs 100000-120000 are reserved for local/custom rules, so this file stays clear
  of Wazuh's own ruleset on upgrade.
-->
<group name="local,homelab_soc,">

  <!-- T1003.001 - OS Credential Dumping: LSASS Memory -->
  <!-- Sysmon Event ID 10 = ProcessAccess. Flags a process opening a handle to lsass.exe
       with an access mask commonly associated with memory-dumping tools (Mimikatz,
       ProcDump abuse, comsvcs.dll MiniDump, etc). -->
  <rule id="100100" level="12">
    <if_group>sysmon_event10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1418|143a|1438)$</field>
    <description>Possible LSASS memory access (credential dumping) - T1003.001</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,mitre_ttp,</group>
  </rule>

  <!-- T1053.005 - Scheduled Task/Job: Scheduled Task -->
  <!-- Sysmon Event ID 1 = ProcessCreate. Flags schtasks.exe being used to create a task. -->
  <rule id="100101" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/create\s</field>
    <description>Scheduled task created via schtasks.exe - T1053.005</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,mitre_ttp,</group>
  </rule>

  <!-- T1547.001 - Boot or Logon Autostart Execution: Registry Run Keys -->
  <!-- Sysmon Event ID 13 = RegistryEvent (Value Set). Flags writes to a Run/RunOnce key. -->
  <rule id="100102" level="10">
    <if_group>sysmon_event13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run(Once)?\\</field>
    <description>Registry Run key modified (possible persistence) - T1547.001</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,mitre_ttp,</group>
  </rule>

  <!-- T1562.001 - Impair Defenses: Disable or Modify Tools -->
  <!-- Sysmon Event ID 1 = ProcessCreate. Flags PowerShell cmdlets that turn off
       Defender's real-time protection or add exclusions. -->
  <rule id="100103" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Set-MpPreference.*-Disable(RealtimeMonitoring|IOAVProtection|ScriptScanning)|Add-MpPreference.*-ExclusionPath)</field>
    <description>Attempt to disable/weaken Windows Defender via PowerShell - T1562.001</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>defense_evasion,mitre_ttp,</group>
  </rule>

</group>
